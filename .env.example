# رابط الـ n8n بتاعك (من غير / في الآخر)
N8N_URL=https://saifsabry.app.n8n.cloud

# من n8n: Settings → n8n API → Create an API key
N8N_API_KEY=paste-your-key-here

# اليوزر والباسورد اللي هتدخل بيهم على الصفحة (لازم تغيّرهم في البرودكشن)
DASH_USER=khaled
DASH_PASS=change-me-to-something-long

PORT=3000

# سر بين الصفحة وworkflow "Control Room – View & Send Draft" في n8n (لازم يطابق اللي في الـ workflow)
N8N_SEND_SECRET=paste-the-secret-here
